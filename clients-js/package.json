{
  "name": "@solana-program/zk-elgamal-proof",
  "version": "0.5.0",
  "description": "JavaScript client for the ZK ElGamal Proof program",
  "sideEffects": false,
  "module": "./dist/src/index.mjs",
  "main": "./dist/src/index.js",
  "types": "./dist/types/index.d.ts",
  "type": "commonjs",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/src/index.mjs",
      "require": "./dist/src/index.js"
    }
  },
  "files": [
    "./dist/src",
    "./dist/types"
  ],
  "scripts": {
    "build": "rimraf dist && tsup && tsc -p ./tsconfig.declarations.json",
    "build:docs": "typedoc",
    "test": "tsc --noEmit && ava --serial --timeout=2m",
    "lint": "oxlint src",
    "lint:fix": "oxlint --fix src",
    "format": "oxfmt --check src test",
    "format:fix": "oxfmt --write src test",
    "prepublishOnly": "pnpm build"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/solana-program/zk-elgamal-proof.git"
  },
  "bugs": {
    "url": "https://github.com/solana-program/zk-elgamal-proof/issues"
  },
  "homepage": "https://github.com/solana-program/zk-elgamal-proof#readme",
  "dependencies": {
    "@solana-program/system": "^0.16.0"
  },
  "peerDependencies": {
    "@solana/kit": "^8.5.0"
  },
  "devDependencies": {
    "@ava/typescript": "^7.0.0",
    "@solana-program/compute-budget": "^0.20.0",
    "@solana-program/record": "^0.6.0",
    "@solana/kit": "^8.5.0",
    "@solana/sysvars": "^8.5.0",
    "@solana/zk-sdk": "workspace:*",
    "@types/node": "^26.6.5",
    "ava": "^8.1.0",
    "oxfmt": "^0.74.0",
    "oxlint": "^1.89.0",
    "rimraf": "^6.1.2",
    "tsup": "^9.0.0",
    "typedoc": "^0.28.20",
    "typescript": "^6.0.3"
  },
  "ava": {
    "nodeArguments": [
      "--no-warnings"
    ],
    "typescript": {
      "compile": false,
      "rewritePaths": {
        "test/": "dist/test/"
      }
    }
  },
  "packageManager": "pnpm@9.1.0"
}
